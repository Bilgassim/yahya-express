# ==============================================================================
# Yahya Express - Configuration Apache / LiteSpeed (.htaccess)
# ==============================================================================

# 1. Forcer la connexion sécurisée HTTPS et le domaine canonique yahyaexpress.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirection HTTP vers HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirection www.yahyaexpress.com vers yahyaexpress.com (facultatif / canonique)
  # RewriteCond %{HTTP_HOST} ^www\.yahyaexpress\.com [NC]
  # RewriteRule ^(.*)$ https://yahyaexpress.com/$1 [L,R=301]
</IfModule>

# 2. En-têtes de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Compression Gzip / Deflate pour un chargement ultra-rapide
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. Mise en cache du navigateur (Browser Caching)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5. Page d'erreur personnalisée 404 (redirection propre vers accueil si page introuvable)
ErrorDocument 404 /index.html
